#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit==0.13.3"]
# ///

import argparse
from collections.abc import MutableMapping
import json
import os
from pathlib import Path
import stat
import sys
import tempfile

import tomlkit


ROOT = Path(__file__).resolve().parent.parent


def merge(target, source, prefix=""):
    changes = []
    for key, value in source.items():
        name = f"{prefix}.{key}" if prefix else key
        if isinstance(value, MutableMapping) and isinstance(target.get(key), MutableMapping):
            changes.extend(merge(target[key], value, name))
        elif key not in target or type(target[key]) is not type(value) or target[key] != value:
            target[key] = value
            changes.append(name)
    return changes


def json_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"Duplicate JSON key: {key}")
        result[key] = value
    return result


def reject_constant(value):
    raise ValueError(f"Invalid JSON constant: {value}")


def parse_json(text):
    value = json.loads(text, object_pairs_hook=json_object, parse_constant=reject_constant)
    if not isinstance(value, dict):
        raise ValueError("Settings JSON must contain an object")
    return value


def plan(source, destination, kind):
    destination = destination.expanduser().resolve()
    before = destination.read_bytes() if destination.exists() else None
    source_text = source.read_text()
    if kind == "style":
        after = source_text.encode()
        changes = ["output style file"] if before != after else []
    else:
        parse = parse_json if kind == "json" else tomlkit.parse
        current = parse(before.decode() if before is not None else ("{}" if kind == "json" else ""))
        changes = merge(current, parse(source_text))
        text = json.dumps(current, indent=2, ensure_ascii=False) + "\n" if kind == "json" else tomlkit.dumps(current)
        parse(text)
        after = text.encode() if changes else before
    return destination, before, after, changes


def apply(destination, before, after):
    current = destination.read_bytes() if destination.exists() else None
    if current != before:
        raise ValueError(f"File changed during merge: {destination}; run again")
    destination.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(destination.stat().st_mode) if before is not None else 0o600
    if before is not None:
        fd, backup = tempfile.mkstemp(prefix=destination.name + ".backup-", dir=destination.parent)
        with os.fdopen(fd, "wb") as stream:
            stream.write(before)
            stream.flush()
            os.fsync(stream.fileno())
        print(f"Backup: {backup}")
    fd, temporary = tempfile.mkstemp(prefix="." + destination.name + ".", dir=destination.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(after)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), mode)
        os.replace(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description="Merge repository settings and install the Claude output style.")
    parser.add_argument("--dry-run", action="store_true", help="Show changed keys and paths without writing target files")
    parser.add_argument("--claude-dir", type=Path, default=Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")))
    parser.add_argument("--codex-home", type=Path, default=Path(os.environ.get("CODEX_HOME", "~/.codex")))
    args = parser.parse_args()
    try:
        plans = [
            plan(ROOT / "claude/settings.json", args.claude_dir / "settings.json", "json"),
            plan(ROOT / "codex/config.toml", args.codex_home / "config.toml", "toml"),
            plan(ROOT / "claude/output-styles/asd-ste100.md", args.claude_dir / "output-styles/asd-ste100.md", "style"),
        ]
        if len({item[0] for item in plans}) != len(plans):
            raise ValueError("Destination files must be distinct")
        for destination, before, after, changes in plans:
            if not changes:
                print(f"Unchanged: {destination}")
                continue
            print(f"{'Would update' if args.dry_run else 'Update'}: {destination}")
            for key in changes:
                print(f"  {key}")
            if not args.dry_run:
                apply(destination, before, after)
    except (OSError, ValueError, tomlkit.exceptions.ParseError) as error:
        print(f"Cannot apply settings: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
